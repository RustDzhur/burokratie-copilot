      "input": "Umfragezeitraum",
      "output": "NPS-Auswertung mit Themen"
    },
    {
      "order": 2,
      "agentId": "support-review-response",
      "title": "Bewertungen beantworten",
      "purpose": "Antwortentwürfe je Bewertung",
      "input": "öffentliche Bewertungen",
      "output": "Antwortentwürfe"
    },
    {
      "order": 3,
      "agentId": "crm-activity",
      "title": "Kundenhistorie ergänzen",
