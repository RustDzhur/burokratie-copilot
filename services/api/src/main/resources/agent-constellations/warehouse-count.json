  "description": {
    "de": "Bereitet die Inventur aus offenen Bestellungen und Lieferterminen vor und erzeugt Zähllisten je Lagerort. Differenzen werden erst nach der zweiten Zählung als Buchungsvorschlag ausgewiesen.",
    "ru": "Готовит инвентаризацию на основе открытых заказов и сроков, формирует листы подсчёта по складам. Расхождения становятся предложением к проводке только после повторного подсчёта."
  },
  "industries": [
    "manufacturing",
    "logistics",
    "ecommerce",
    "retail",
    "handwerk"
  ],
  "steps": [
    {
      "order": 1,
      "agentId": "logistics-inventory-count",
      "title": "Inventur planen",
      "purpose": "Zähllisten und Stichtag festlegen",
      "input": "Lager und Stichtag",
      "output": "Zähllisten"
    },
    {
      "order": 2,
      "agentId": "logistics-delivery-tracking",
      "title": "Wareneingang prüfen",
      "purpose": "Erwartete Lieferungen einbeziehen",
      "input": "offene Bestellungen",
      "output": "Lieferliste"
    },
    {
      "order": 3,
      "agentId": "logistics-order-intake",
