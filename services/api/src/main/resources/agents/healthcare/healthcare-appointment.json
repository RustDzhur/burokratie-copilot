    "mail.received",
    "phone.transcript"
  ],
  "inputs": {
    "patientContactId": "uuid (optional)",
    "appointmentType": "string (erforderlich)",
    "preferredPeriod": "string (optional)",
    "urgency": "NORMAL | URGENT | EMERGENCY",
    "practitionerId": "uuid (optional)"
  },
  "config": {
    "systems": [
      "Praxissoftware",
      "Kalender",
      "Telefon",
      "E-Mail"
    ],
    "version": "1.0",
