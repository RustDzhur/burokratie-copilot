    "Abweichungs-Bericht"
  ],
  "triggers": [
    "manual",
    "bank.statement.imported",
    "schedule"
  ],
  "inputs": {
    "accountId": "uuid (optional)",
    "periodFrom": "date (erforderlich)",
    "periodTo": "date (erforderlich)",
    "minAmount": "decimal (optional)",
    "toleranceCents": "integer (Standard 0)"
  },
  "config": {
    "systems": [
      "Bank",
      "Rechnungen",
      "Buchhaltung"
    ],
    "version": "1.0",
    "status": "ACTIVE"
