# Base URL of the backend REST API (versioned).
# Leave as the default when the web client is served behind the same origin / reverse proxy
# that exposes the Spring Boot backend under /api/v1.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional: request timeout in milliseconds for the typed API client (default 20000).
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# Optional: default UI locale shipped by the server render (de | en | ru). Default: de
NEXT_PUBLIC_DEFAULT_LOCALE=de
