# =============================================================================
#  Bürokratie-Copilot — environment template
# =============================================================================
#  Copy this file and fill in real values:
#
#      cp infra/.env.example infra/.env
#      chmod 600 infra/.env
#
#  NEVER commit `infra/.env`. It is listed in .gitignore and CI fails the build
#  if an .env file is tracked (job `security` in .github/workflows/ci.yml).
#
#  All backend settings are read from the environment with the `BC_` prefix
#  (see services/api/src/main/resources/application.yml). Nothing here is a real
#  secret: every value is an obvious placeholder that MUST be replaced before a
#  production deployment. Placeholders use `<...>` or `change-me-*` so that
#  secret scanners and humans can tell them apart from real credentials.
#
#  READ THE NOTE ON EVERY BLOCK. Variables fall into three groups:
#    (a) read by the backend today — declared in application*.yml;
#    (b) consumed by Compose / the infra scripts — never read by the JVM at all;
#    (c) reserved for adapters that are NOT implemented yet, explicitly marked
#        "not read by the application" so that nobody assumes a feature exists
#        merely because an environment variable is present.
#
#  Blast-radius warning: many of these values are interpolated into
#  docker-compose.yml. Compose interpolates every `${VAR}` it finds, so a
#  malformed value here can break `docker compose config` even for services you
#  are not starting. Keep one variable per line, no trailing spaces, no quotes
#  unless the value itself needs them.
#
#  ── WHAT MUST BE CHANGED BEFORE PRODUCTION ────────────────────────────────
#  Mandatory (the `prod` profile refuses to start without them — see
#  de.buerokratiecopilot.shared.config.ProductionConfigurationGuard):
#    1. BC_DB_PASSWORD            — real database password
#    2. BC_ENCRYPTION_KEY         — base64 of 32 random bytes; generate with
#                                   `openssl rand -base64 32`
#                                   Data encrypted with the old key CANNOT be
#                                   read after a change (no hot rotation).
#    3. BC_S3_ACCESS_KEY / BC_S3_SECRET_KEY — real object-storage credentials
#    4. BC_PUBLIC_BASE_URL        — the public HTTPS URL of the deployment
#    5. BC_COOKIE_SECURE=true     — force Secure cookies (prod profile does this)
#    6. POSTGRES_PASSWORD         — must equal BC_DB_PASSWORD
#    7. MINIO_ROOT_PASSWORD       — replaced by real S3 credentials in prod
#  Strongly recommended: BC_S3_* (never use local-fs storage in production —
#  container-local blobs are lost on redeploy and are not shared by api/worker),
#  TLS termination at the reverse proxy, a real SMTP relay, off-host backups.
#
#  ── FEATURES THAT STAY DISABLED WITHOUT CREDENTIALS ───────────────────────
#    * BC_AI_ENABLED=false  (default) — no AI classification, extraction,
#      assistant or embeddings. Requires BC_AI_API_KEY + BC_AI_BASE_URL and a
#      provider contract; set BC_AI_MONTHLY_BUDGET_EUR to cap spending.
#    * BC_OCR_ENABLED=false — no text recognition from scans/images (production refuses to start so, unless BC_ALLOW_NO_OCR=true).
#      Requires a Tesseract installation with the `deu` language pack in the
#      worker image (or a configured external OCR engine).
#    * Mail sending/receiving — requires an SMTP relay and/or OAuth app
#      registrations (Microsoft 365 / Google Workspace). See docs/integrations.md.
#    * Banking, accounting, CRM, e-signature, e-invoicing adapters — require
#      contracts/credentials from the system owner. See docs/integrations.md.
#  The application must degrade gracefully: a disabled integration must be
#  reported as disabled/unavailable in the UI — never faked.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Deployment / images                  (Compose + CI only — not read by the JVM)
# -----------------------------------------------------------------------------
# Compose project name; also used as a prefix for named volumes.
COMPOSE_PROJECT_NAME=burokratie-copilot
# Image tag for api/worker/web. Release builds: git SHA or semver (spec §30).
# The same digest must be promoted from staging to production — never rebuild.
BC_IMAGE_TAG=local
# Container registry prefix used by docker-compose.prod.yml (e.g. ghcr.io/acme).
BC_REGISTRY=ghcr.io/example-org

# -----------------------------------------------------------------------------
# 2. Network surface                     (Compose/reverse proxy — not read by the JVM)
# -----------------------------------------------------------------------------
# Dev: bind published ports to loopback only. Keep 127.0.0.1 for local work.
# Prod: the prod override publishes nothing except the reverse proxy, so this
# value only affects the reverse-proxy binding there.
BC_BIND_ADDRESS=127.0.0.1
# Public URL of the web frontend. READ BY THE BACKEND: used in e-mails, links
# and invite tokens. Must be the HTTPS URL in production.
BC_PUBLIC_BASE_URL=http://localhost:3000
# Hostnames served by the reverse proxy in production (comma separated).
BC_SERVER_NAMES=app.example.de
# Reverse proxy listen ports (prod override).
BC_HTTP_PORT=80
BC_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# 3. PostgreSQL 17
# -----------------------------------------------------------------------------
# Inside Compose the api/worker connect to the `postgres` service by name.
BC_DB_HOST=postgres
BC_DB_PORT=5432
BC_DB_NAME=burokratie
BC_DB_USER=burokratie
# >>> REPLACE. Placeholder only. Generate: openssl rand -base64 24
BC_DB_PASSWORD=change-me-dev-only
# HikariCP pool size. Keep well below max_connections (default 100).
BC_DB_POOL_SIZE=10
# Postgres container parameters (interpolated into the `postgres` service command;
# not read by the JVM). Raise these with the container's memory limit.
BC_DB_MAX_CONNECTIONS=100
BC_DB_SHARED_BUFFERS=256MB
# Log any statement slower than this many milliseconds (0 logs everything).
BC_DB_LOG_SLOW_MS=1000
# Postgres container superuser (used only by the postgres/minio-init services).
POSTGRES_USER=burokratie
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=burokratie
# Published on the host in the DEV stack only (loopback). The prod override
# removes the port entirely.
BC_DB_PORT_PUBLISHED=5432
# Worker/API startup may wait for the DB; the compose healthcheck is the gate.
BC_FLYWAY_ENABLED=true
# Spring profile for the api container (dev by default; the prod override sets
# `prod` explicitly). The worker always runs with the `worker` profile.
BC_SPRING_PROFILE_API=dev

# -----------------------------------------------------------------------------
# 4. Object storage — MinIO (dev) / any S3-compatible endpoint (prod)
# -----------------------------------------------------------------------------
# local-fs | s3. Use `s3` whenever more than one process writes blobs
# (api + worker) or when containers are recreated.
BC_STORAGE_TYPE=s3
# Only used when BC_STORAGE_TYPE=local-fs. Must be a volume-mounted path.
BC_STORAGE_PATH=/app/data/blobs
# Dev: MinIO runs in Compose on the internal network.
BC_S3_ENDPOINT=http://minio:9000
BC_S3_REGION=eu-central-1
BC_S3_BUCKET=burokratie
# >>> REPLACE. Dev defaults below match MINIO_ROOT_*; production must use a
# dedicated access key scoped to the bucket, stored in a secret manager.
BC_S3_ACCESS_KEY=burokratie
BC_S3_SECRET_KEY=change-me-dev-only
# MinIO bootstrap (minio-init service) — dev only.
MINIO_ROOT_USER=burokratie
MINIO_ROOT_PASSWORD=change-me-dev-only
# Host port for the MinIO S3 API. Needed by the backup script (mc/aws run on the
# host in the drill documented in docs/runbook.md).
BC_S3_PORT_PUBLISHED=9000
# MinIO web console (dev only; never published by the prod override).
BC_MINIO_CONSOLE_PORT=9001
BC_MINIO_CONSOLE_URL=http://localhost:9001

# -----------------------------------------------------------------------------
# 5. API runtime
# -----------------------------------------------------------------------------
BC_PORT=8080
# Host port published for the api (dev stack, loopback binding); the prod
# override publishes nothing and lets the reverse proxy forward /api.
BC_API_PORT=8080
BC_WORKER_MANAGEMENT_PORT=8081
BC_WORKER_CONCURRENCY=4
BC_MAX_UPLOAD_SIZE=100MB
BC_MAX_REQUEST_SIZE=250MB
# >>> REPLACE with `openssl rand -base64 32` (exactly 32 bytes, base64 encoded).
# Used for AES-256 encryption of stored credentials/secrets (spec §21.1).
BC_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Set true in production (Secure + SameSite cookie attributes). The `prod`
# profile forces cookie-secure=true regardless of this value.
BC_COOKIE_SECURE=false
# JVM flags for api/worker containers. Container-aware: the JVM derives the heap
# from the cgroup limit; 75% is a safe default for a single-process container.
BC_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -XX:+UseContainerSupport -Djava.security.egd=file:/dev/./urandom
# Memory limits (prod override). api + worker are sized independently.
BC_API_MEMORY_LIMIT=2g
BC_WORKER_MEMORY_LIMIT=2g
BC_WEB_MEMORY_LIMIT=512m
BC_POSTGRES_MEMORY_LIMIT=2g
# CPU limits (prod override, `deploy.resources.limits.cpus`).
BC_API_CPUS=2
BC_WORKER_CPUS=2
BC_WEB_CPUS=1
BC_POSTGRES_CPUS=2
BC_MINIO_CPUS=2
BC_MINIO_MEMORY_LIMIT=1g
# Memory reservations (prod override, `deploy.resources.reservations.memory`).
BC_API_MEMORY_RESERVATION=1g
BC_WORKER_MEMORY_RESERVATION=1g
BC_POSTGRES_MEMORY_RESERVATION=1g

# -----------------------------------------------------------------------------
# 5b. Reverse proxy (prod override, profile `proxy`)
# -----------------------------------------------------------------------------
# Bind address for ports 80/443. 0.0.0.0 is intended for a public host; use
# 127.0.0.1 when a host-level load balancer or another proxy sits in front.
BC_BIND_ADDRESS_PROD=0.0.0.0
# Directory holding tls.crt and tls.key (they are mounted read-only, never baked
# into an image). chmod 600 the key.
BC_TLS_DIR=./nginx/certs
# nginx client_max_body_size. MUST be >= BC_MAX_REQUEST_SIZE, otherwise nginx
# rejects an upload before the application can stream it.
BC_NGINX_CLIENT_MAX_BODY=250m
BC_PROXY_CPUS=1
BC_PROXY_MEMORY_LIMIT=256m

# -----------------------------------------------------------------------------
# 5c. Optional secret files (preferred over plain environment variables)
# -----------------------------------------------------------------------------
# When a secret is mounted as a file (Docker secrets, SOPS, cloud secret manager),
# set the path here: Spring Boot's *_FILE convention takes precedence over the
# matching environment variable. Leave empty to use BC_DB_PASSWORD directly.
BC_DB_PASSWORD_FILE=
POSTGRES_PASSWORD_FILE=

# -----------------------------------------------------------------------------
# 5d. PostgreSQL tuning (prod override; not read by the JVM)
# -----------------------------------------------------------------------------
BC_DB_EFFECTIVE_CACHE=1536MB

# -----------------------------------------------------------------------------
# 5e. Image provenance (set by CI, not by hand)
# -----------------------------------------------------------------------------
# Recorded in the images as an OCI label so `docker image inspect` answers
# "which revision is this?". CI sets it automatically; for a manual build use
# `--build-arg BUILD_REVISION=$(git rev-parse --short HEAD)`.
BC_BUILD_REVISION=

# -----------------------------------------------------------------------------
# 6. Frontend (apps/web)
# -----------------------------------------------------------------------------
# Public API base URL baked into the Next.js client bundle at BUILD time
# (build arg). Same-origin is recommended in production: the reverse proxy
# routes /api/* to the backend so session cookies stay first-party.
# MUST be the relative path "/api/v1": page and API share one origin (see docs/deployment.md 2.2).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Where the Next.js server forwards /api/v1/* when no reverse proxy does it first (build arg).
BC_API_ORIGIN=http://api:8080
# Runtime bind for the standalone Next.js server inside the container.
BC_WEB_PORT=3000
BC_WEB_HOSTNAME=0.0.0.0

# -----------------------------------------------------------------------------
# 7. Mail (outbound/inbound) — DISABLED until configured
# -----------------------------------------------------------------------------
# Read by the backend today: only the From address.
BC_MAIL_FROM=no-reply@buerokratie-copilot.local
#
# Outbound mail IS partially implemented and uses SPRING BOOT'S OWN property
# namespace, not the BC_ prefix (verified in
# services/api/.../shared/mail/DefaultEmailSender.java: it reads
# `spring.mail.host` and builds the message with the JavaMailSender bean):
#   SPRING_MAIL_HOST / SPRING_MAIL_PORT / SPRING_MAIL_USERNAME / SPRING_MAIL_PASSWORD
# Without SPRING_MAIL_HOST there is no JavaMailSender bean at all: `isConfigured()`
# returns false, the message body is written to the APPLICATION LOG instead of
# being sent, and the API reports that no mail was delivered. Registration
# requires e-mail verification, so without a working relay NO ACCOUNT CAN BE
# COMPLETED — see docs/integrations.md §3.3.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Optional STARTTLS/AUTH tuning (Spring Boot properties):
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
#
# Inbound mailboxes are connected per account in the application (Mail > connect); their credentials are
# stored encrypted in the database, so there are no BC_MAIL_IMAP_*, BC_M365_* or BC_GOOGLE_* variables.

# -----------------------------------------------------------------------------
# 8. AI provider — DISABLED by default
# -----------------------------------------------------------------------------
# Keep false unless a provider contract and API key exist. With AI disabled all
# AI-powered features must report "AI disabled" instead of a fabricated result.
BC_AI_ENABLED=false
# none | openai | azure-openai | ollama | custom  (provider ids are validated
# by the backend; `none` means no external calls are possible)
BC_AI_PROVIDER=none
BC_AI_BASE_URL=
# >>> REPLACE with the owner-provided key. Backend only — never exposed to the
# browser and never logged.
BC_AI_API_KEY=
# Hard monthly spend cap in EUR (0 = no cap configured; the UI shows the cap).
BC_AI_MONTHLY_BUDGET_EUR=0

# -----------------------------------------------------------------------------
# 9. OCR — DISABLED by default
# -----------------------------------------------------------------------------
# Requires a Tesseract binary with language data inside the worker image.
BC_OCR_ENABLED=true
# tesseract | external
# Malware scanning of every upload (clamscan is installed in the image). 'none' is refused in production
# unless BC_ALLOW_UNSCANNED=true is set on purpose.
BC_MALWARE_SCANNER=clamav-cli
# Wrapper that asks the long-running clamd service (container `clamav`) instead of starting clamscan per upload.
BC_CLAMAV_PATH=/usr/local/bin/clamd-remote-scan
BC_MALWARE_SCAN_SPOOL=/app/data/scan-spool
BC_MALWARE_SCAN_TIMEOUT=PT2M
BC_OCR_ENGINE=tesseract
# `+` separated Tesseract language packs, German first (spec §9.2).
BC_OCR_LANGUAGES=deu+eng
BC_TESSERACT_PATH=tesseract

# -----------------------------------------------------------------------------
# 10. Backup / restore (infra/scripts) — host-side, not read by the application
# -----------------------------------------------------------------------------
# Directory for pg_dump dumps + object-storage copies. MUST live outside the
# repository working tree in production and MUST be copied off-host.
BC_BACKUP_DIR=infra/backups
# Retention in days for local dumps (documented in docs/runbook.md).
BC_BACKUP_RETENTION_DAYS=14
# Host that backup.sh/restore.sh treat as "production-looking" and refuse to
# touch without I_KNOW_THIS_IS_PRODUCTION=yes (restore: FORCE=yes).
BC_PRODUCTION_DB_HOSTS=prod-db.internal,db.example.de

# -----------------------------------------------------------------------------
# 11. Monitoring / observability
# -----------------------------------------------------------------------------
# Timezone of the CONTAINERS (logs and local-time rendering). The database stores
# UTC regardless; the application renders times per user profile timezone.
TZ=Europe/Berlin
# Actuator metrics are exposed on /actuator/prometheus (api: BC_PORT,
# worker: BC_WORKER_MANAGEMENT_PORT). Restrict /actuator/* at the proxy.
# Log format: the `prod` Spring profile emits structured JSON (logstash
# encoder). Never log personal data or secrets (spec §21.1, §27).
BC_LOG_LEVEL=INFO

# false closes registration for everybody (POST /auth/register answers 403). Set it once the owner has registered.
BC_REGISTRATION_OPEN=true

# Platform administrators: e-mail addresses (comma separated) that get the /admin area (customers, plans, payments,
# the platform's payment details). Only an address that has also been verified by the e-mail link counts.
BC_PLATFORM_ADMINS=
