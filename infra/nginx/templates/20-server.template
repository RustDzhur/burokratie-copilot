# =============================================================================
#  Bürokratie-Copilot — reverse proxy / TLS termination
# =============================================================================
#  This file is a TEMPLATE. The official nginx image entrypoint renders every
#  /etc/nginx/templates/*.template file with `envsubst` into
#  /etc/nginx/conf.d/<name>.conf at container start. Only these variables are
#  substituted (they come from docker-compose.prod.yml):
#
#      BC_SERVER_NAMES            e.g. "app.example.de,www.app.example.de"
#      BC_NGINX_CLIENT_MAX_BODY   must be >= BC_MAX_REQUEST_SIZE, e.g. "250m"
#
#  All other $variables are normal nginx runtime variables and are left alone.
#
#  Routing model (same origin, no CORS, first-party session cookies):
#      /            -> web:3000   (Next.js standalone server)
#      /api/        -> api:8080   (Spring Boot REST API, /api/v1/...)
#      /actuator/   -> api:8080   (metrics/health — restricted to private nets)
#      /healthz     -> proxy itself, 200 OK (for external load balancers)
#
#  TLS certificates are bind-mounted from the host at /etc/nginx/certs/tls.crt
#  and /etc/nginx/certs/tls.key (see docs/deployment.md for issuance/renewal).
# =============================================================================

# Only trust X-Forwarded-Proto from a proxy in front of us. With a single proxy
# (this container) or a cloud LB setting the header, this is the correct value.
map $http_x_forwarded_proto $bc_forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}

# HSTS is only sent over HTTPS (sending it over plain HTTP is meaningless and
# `includeSubDomains` must be a deliberate operator decision).
map $bc_forwarded_proto $bc_hsts {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

# ---------------------------------------------------------------------------
# Plain HTTP listener: health probe + permanent redirect to HTTPS
# ---------------------------------------------------------------------------
server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name $BC_SERVER_NAMES _;

    # Small body limit: this listener must never accept an upload.
    client_max_body_size 1m;

    # Unauthenticated liveness endpoint for an external load balancer / uptime
    # check. It answers before TLS so the certificate is not a dependency.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # Anything else is encrypted; 308 preserves the method and body.
    location / {
        return 308 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS listener: the actual application
# ---------------------------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name $BC_SERVER_NAMES;

    # TLS material is provided by the host/secret store, never by the image.
    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:BC_TLS:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;
    # OCSP stapling requires a resolver; enable it when the host has a DNS
    # resolver available (docs/deployment.md).
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # resolver 1.1.1.1 9.9.9.9 valid=300s;

    # The rate-limit ZONES are declared in the http context
    # (infra/nginx/templates/10-http-common.template, which loads first). They
    # are applied per location below — a server-wide `limit_req` would also
    # throttle static assets and break double-submits.
    #
    # NOTE on the backend path. The spec (§20) puts the API under `/api/v1`, so
    # the URI is passed through UNCHANGED: /api/v1/documents -> api:8080/api/v1/….
    # If the application serves its controllers at the root instead, uncomment
    # the `rewrite` inside the /api/ location. Verify against the generated
    # OpenAPI document (/api-docs) before go-live.

    # -----------------------------------------------------------------------
    # Authentication surface: strictest rate limit (credential stuffing)
    # -----------------------------------------------------------------------
    location /api/v1/auth/ {
        limit_req zone=bc_auth burst=10 nodelay;

        proxy_pass http://api:8080;
        include /etc/nginx/conf.d/bc-proxy-params.conf;
        client_max_body_size 1m;
        proxy_read_timeout 60s;
    }

    # -----------------------------------------------------------------------
    # API
    # -----------------------------------------------------------------------
    location /api/ {
        limit_req zone=bc_api burst=100 nodelay;

        proxy_pass http://api:8080;
        include /etc/nginx/conf.d/bc-proxy-params.conf;

        # Uploads are streamed: never buffer a whole document in the proxy.
        proxy_request_buffering off;
        proxy_buffering off;
        client_max_body_size $BC_NGINX_CLIENT_MAX_BODY;
        # Long-running requests (document import, report generation).
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
        proxy_connect_timeout 10s;
    }

    # -----------------------------------------------------------------------
    # Actuator / metrics — NEVER public. Allowed only from loopback and the
    # private ranges used by the internal Docker networks and monitoring hosts.
    # -----------------------------------------------------------------------
    location /actuator/ {
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny  all;

        proxy_pass http://api:8080;
        include /etc/nginx/conf.d/bc-proxy-params.conf;
        access_log off;
    }

    # Next.js build artefacts are content-hashed: cache them aggressively.
    location /_next/static/ {
        proxy_pass http://web:3000;
        include /etc/nginx/conf.d/bc-proxy-params.conf;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # -----------------------------------------------------------------------
    # Web frontend (default route)
    # -----------------------------------------------------------------------
    location / {
        proxy_pass http://web:3000;
        include /etc/nginx/conf.d/bc-proxy-params.conf;

        client_max_body_size $BC_NGINX_CLIENT_MAX_BODY;
        # Server-sent events / streaming responses from the Next.js server.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    # -----------------------------------------------------------------------
    # Shared security headers (spec §21.3: XSS/clickjacking protection)
    # -----------------------------------------------------------------------
    # `always` keeps them on error responses too. The CSP allows the inline
    # bootstrap scripts Next.js emits; tighten it with a nonce once the frontend
    # supports one (docs/security.md).
    add_header Strict-Transport-Security "$bc_hsts" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(self), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy   "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # Do not advertise the exact nginx version.
    server_tokens off;

    # Never serve dotfiles (.env, .git, ...) even if a misconfiguration exposes them.
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
    }
}
