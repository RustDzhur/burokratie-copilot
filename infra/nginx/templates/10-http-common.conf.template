# =============================================================================
#  HTTP-context settings shared by all server blocks
# =============================================================================
#  Rendered by the nginx image entrypoint (envsubst) into
#  /etc/nginx/conf.d/10-http-common.conf. It is loaded BEFORE 20-server.conf, so
#  every `limit_req_zone` referenced by the server blocks already exists.
# =============================================================================

# ---------------------------------------------------------------------------
# WebSocket / HTTP upgrade handling
# ---------------------------------------------------------------------------
# nginx refuses `Connection: upgrade` unless it is set explicitly; the classic
# idiom is a map so that ordinary HTTP requests get `Connection: close`. Without
# this map the `proxy_set_header Connection $connection_upgrade` in
# bc-proxy-params.conf cannot be resolved and nginx refuses to start.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------------------
# Rate limiting (spec §21.3: brute-force and request-rate protection)
# ---------------------------------------------------------------------------
# The backend implements its own login throttling and lockout. This is a second,
# coarser layer at the edge: it stops credential stuffing from consuming
# application resources at all.
#
# `binary_remote_addr` is the proxy's peer address. Behind a cloud load
# balancer, configure `set_real_ip_from` + `real_ip_header X-Forwarded-For`
# here, otherwise every client shares one bucket.
limit_req_zone $binary_remote_addr zone=bc_auth:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=bc_api:10m  rate=50r/s;

# Return 429 (not the nginx default 503) so clients and monitors can tell
# throttling apart from an outage.
limit_req_status 429;
limit_conn_status 429;

# Connection cap per client address; protects against slow-loris style load.
limit_conn_zone $binary_remote_addr zone=bc_conn:10m;
limit_conn bc_conn 50;

# Uploads are streamed to the backend; keep the default timeout generous enough
# for slow mobile connections but bounded.
client_body_timeout   60s;
client_header_timeout 30s;
send_timeout          120s;

# Do not let a client negotiate a needlessly weak handshake.
ssl_protocols TLSv1.2 TLSv1.3;

# Log format: no query strings (they can carry tokens), no request bodies.
# Correlation IDs are added by the application, not by the proxy.
log_format bc_main '$remote_addr - $remote_user [$time_local] '
                   '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" rt=$request_time urt=$upstream_response_time';
access_log /dev/stdout bc_main;
error_log  /dev/stderr warn;
