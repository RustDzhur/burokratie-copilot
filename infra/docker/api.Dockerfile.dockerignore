# =============================================================================
#  Build context exclusions for infra/docker/api.Dockerfile
# =============================================================================
#  The build context is the REPOSITORY ROOT, which means the whole working tree
#  is uploaded to the Docker daemon before the build starts. This file keeps that
#  context small and — more importantly — keeps secrets and unrelated runtime
#  state out of it.
#
#  BuildKit (default since Docker 23) picks up `<dockerfile>.dockerignore`
#  automatically. On an ancient builder that only understands the root
#  `.dockerignore`, the root file covers the same ground.
# =============================================================================

# --- secrets: must never enter a build context -------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
secrets/
**/secrets/
*.pem
*.key
*.p12
*.jks
*.keystore
infra/nginx/certs/

# --- version control / editor ------------------------------------------------
.git
.git/**
.gitignore
.gitattributes
.github/
.idea/
.vscode/
.DS_Store
**/.DS_Store

# --- build output (rebuilt inside the image) ---------------------------------
**/target/
**/build/
**/out/
**/dist/
**/.next/
**/node_modules/
**/.turbo/
**/.pnpm-store/
**/coverage/

# --- runtime state and backups (never bake data into an image) ---------------
infra/backups/
infra/data/
**/*.log
logs/
**/heapdump*.hprof

# --- other deliverables: not needed to build the backend ---------------------
apps/
tests/
docs/
README.md
infra/docker-compose*.yml
infra/docker/web.Dockerfile
